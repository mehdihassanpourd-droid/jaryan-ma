# TEMPLATE ONLY. Nothing deploys this file: the Pages workflow publishes `out/` only.
# Copy to wrangler.toml and fill in after the owner approves the Cloudflare resources
# (docs/admin/CLOUDFLARE-SETUP.md). Contains identifiers, never secrets.

name = "jaryan-ma-admin"
main = "src/index.ts"
compatibility_date = "2026-10-01"

# Reachable only through the Access-protected custom domain.
workers_dev = false
preview_urls = false

[[d1_databases]]
binding = "DB"
database_name = "jaryan-ma-admin"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "migrations"

[[r2_buckets]]
binding = "BUCKET"
bucket_name = "jaryan-ma-public"

[vars]
ACCESS_TEAM_DOMAIN = "REPLACE_TEAM.cloudflareaccess.com"
ACCESS_AUD = "REPLACE_WITH_ACCESS_APPLICATION_AUD_TAG"
ADMIN_ORIGINS = "https://admin.example.com"
PUBLIC_BUCKET_URL = "https://cdn.example.com"
IMPORT_CHUNK_MAX = "10"
