# /etc/jaryan-ma/minio.env  (mode 0600, owner minio). NEVER commit a real copy.
# The root credentials of the object store. They are NOT the application's S3 keys: create a separate access key for the
# application in the object store and put that one in api.env. Generate long random values (openssl rand -base64 24).
MINIO_ROOT_USER=CHANGE-ME
MINIO_ROOT_PASSWORD=CHANGE-ME
# the web console is off in production
MINIO_BROWSER=off
