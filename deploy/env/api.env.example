# /etc/jaryan-ma/api.env — mode 0640, owner root, group jaryan. NEVER commit a real copy, never paste it into a chat.
# Every value marked CHANGE-ME must be replaced before the installer will continue.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001

# PostgreSQL on this machine (listen on localhost only)
DATABASE_URL=postgresql://jaryan:CHANGE-ME@127.0.0.1:5432/jaryan

# S3-compatible object storage on this machine, reachable only on localhost (see nginx media.conf)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=jaryan-media
S3_ACCESS_KEY_ID=CHANGE-ME
S3_SECRET_ACCESS_KEY=CHANGE-ME
S3_FORCE_PATH_STYLE=true
PUBLIC_MEDIA_URL=https://media.example.ir

# the admin PWA is served by this same server on the admin host
ADMIN_ORIGINS=https://admin.example.ir
# 32 random bytes, base64:  openssl rand -base64 32   (BACK IT UP outside this server: without it TOTP seeds cannot be decrypted)
APP_ENCRYPTION_KEY=CHANGE-ME
TRUST_PROXY=true

# customer sign-in stays OFF until an SMS gateway is configured
CUSTOMER_ACCOUNTS_ENABLED=false
# CUSTOMER_ORIGINS=https://shop.example.ir

# backups (jaryan-ops backup / backup-verify / restore-test)
BACKUP_DIR=/var/backups/jaryan
BACKUP_ENCRYPTION_KEY=CHANGE-ME
BACKUP_KEEP_DAYS=30
BACKUP_MAX_AGE_HOURS=36

# alerts: console is always on; add a local file and/or an optional internal webhook
ALERT_SINKS=console,file
ALERT_FILE=/var/log/jaryan/alerts.jsonl
