# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts

# build / test output
/build
/coverage
*.tsbuildinfo

# env files (never commit secrets; .env.example is the template)
.env
.env.*
!.env.example

# generated
/src/generated

# misc
.DS_Store
npm-debug.log*

# local development data (embedded database, uploaded media, dev key) and server bundle
/.data/
/dist/

# local backups (encrypted dumps still contain personal data: never commit)
/backups/
*.dump
*.dump.enc
