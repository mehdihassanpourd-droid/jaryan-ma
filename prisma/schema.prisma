// Jaryan Ma (جریان ما) — data model.
// Multi-vendor ready: every sellable thing and every order line belongs to a Vendor.
// Today exactly one Vendor exists (the gallery itself, kind = PLATFORM).
// NOTE: the product catalogue is proposed to move to Cloudflare D1 (docs/admin/ARCHITECTURE.md).
// This schema stays the reference model until that decision is approved.
//
// Payments are intentionally NOT modelled yet (see PRD.md, "Out of scope").

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  VENDOR_STAFF
  ADMIN
}

enum VendorKind {
  PLATFORM // the gallery itself (single-vendor phase)
  INDEPENDENT // third-party artist/seller (marketplace phase)
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING // created, awaiting payment integration / manual confirmation
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique // Iranian mobile, normalised 09XXXXXXXXX
  name      String?
  email     String?  @unique
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendorMemberships VendorMember[]
  addresses         Address[]
  orders            Order[]
}

model Vendor {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  kind        VendorKind   @default(INDEPENDENT)
  status      VendorStatus @default(PENDING)
  bio         String?
  instagram   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  members    VendorMember[]
  products   Product[]
  orderItems OrderItem[]
}

model VendorMember {
  vendorId String
  userId   String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([vendorId, userId])
}

model Category {
  id       String     @id @default(cuid())
  slug     String     @unique
  name     String
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Product {
  id          String        @id @default(cuid())
  vendorId    String
  categoryId  String?
  slug        String        @unique
  title       String
  description String?
  // Price in Toman as an integer. Null = "price not announced".
  priceToman  Int?
  stock       Int           @default(1) // handmade: often one-of-a-kind
  isUnique    Boolean       @default(true)
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  vendor     Vendor         @relation(fields: [vendorId], references: [id])
  category   Category?      @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  orderItems OrderItem[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([status])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  recipient  String
  phone      String
  province   String
  city       String
  street     String
  postalCode String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Order {
  id           String      @id @default(cuid())
  number       String      @unique
  userId       String
  status       OrderStatus @default(PENDING)
  totalToman   Int
  shippingJson Json // snapshot of the delivery address at order time
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId])
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  productId         String
  vendorId          String // denormalised so payouts/fulfilment can be split per vendor
  titleSnapshot     String
  unitPriceToman    Int
  quantity          Int     @default(1)
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product @relation(fields: [productId], references: [id])
  vendor            Vendor  @relation(fields: [vendorId], references: [id])

  @@index([orderId])
  @@index([vendorId])
}
