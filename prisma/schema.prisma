// Jaryan Ma (جریان ما) — PostgreSQL data model (production, self-hosted in Iran).
//
// Areas: catalogue, administrators, customers (phone/OTP accounts), orders (read model: no checkout or
// payments yet), customer support, and technical maintenance. Everything is portable PostgreSQL.
//
// Multi-vendor ready: every product and order line belongs to a Vendor. Today exactly one Vendor exists
// (the gallery itself, kind = PLATFORM), created by the server at startup.
//
// The catalogue models mirror src/domain exactly (same enums, same rules); the domain layer validates, the
// database enforces the invariants that must never be broken (see prisma/migrations/*_constraints*).
//
// Money: whole Toman stored as BIGINT (BigInt), so totals can never overflow in the database. The application
// exposes amounts as JS numbers bounded by MAX_TOMAN (src/domain/money.ts) so JSON stays exact.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------
// Enums (lower-case values on purpose: they are the strings the domain layer and the API use)
// ---------------------------------------------------------------------------------------------

enum VendorKind {
  PLATFORM // the gallery itself (single-vendor phase)
  INDEPENDENT // third-party artist/seller (marketplace phase)
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  draft
  published
  archived
}

enum Fulfillment {
  unique
  stocked
  made_to_order
}

enum AdminRole {
  owner
  editor
  support
  viewer
}

enum CustomerStatus {
  active
  pending_deletion
  anonymized
  suspended
}

enum OtpPurpose {
  sign_in
}

enum OrderStatus {
  pending // placed, awaiting confirmation (no online payment yet)
  confirmed
  preparing
  shipped
  delivered
  cancelled
  /// Refused by staff before confirmation (reserved stock is released).
  rejected
}

enum OrderActor {
  customer
  staff
  system
}

enum DataRequestType {
  export
  deletion
}

enum DataRequestStatus {
  requested
  completed
  cancelled
}

enum TicketStatus {
  open
  in_progress
  waiting_customer
  resolved
  closed
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

enum TicketCategory {
  order
  product
  shipping
  returns
  account
  website
  other
}

enum MessageAuthor {
  customer
  staff
  system
}

enum IncidentSeverity {
  minor
  major
  critical
}

enum IncidentStatus {
  investigating
  identified
  monitoring
  resolved
}

enum IncidentSource {
  manual
  health_check
  deployment
  security
  backup
}

enum BackupKind {
  database
  media
}

// ---------------------------------------------------------------------------------------------
// Vendors and catalogue
// ---------------------------------------------------------------------------------------------

model Vendor {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  kind      VendorKind   @default(INDEPENDENT)
  status    VendorStatus @default(PENDING)
  bio       String?
  instagram String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  products   Product[]
  orderItems OrderItem[]
}

model Category {
  id        String     @id @default(uuid())
  slug      String     @unique
  name      String
  parentId  String?
  position  Int        @default(0)
  createdAt DateTime   @default(now())
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@map("categories")
}

model Product {
  id           String        @id @default(uuid())
  vendorId     String
  slug         String        @unique
  name         String
  description  String        @default("")
  /// Optional page title / meta description chosen by an editor. Null = generated automatically (src/seo).
  seoTitle       String?
  seoDescription String?
  categoryId   String?
  status       ProductStatus @default(draft)
  fulfillment  Fulfillment
  /// Whole Toman (BIGINT). Null = price not announced. App range: 0..MAX_TOMAN (src/domain/money.ts).
  priceToman   BigInt?
  /// unique: 0 or 1. stocked: stock (null when variants carry it). made_to_order: always null.
  inventory    Int?
  leadTimeDays Int?
  /// Normalised name + description + SKUs for search (see normalizeForSearch).
  searchText   String        @default("")
  /// Optimistic concurrency: updates must present the version they read.
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now())
  publishedAt  DateTime?

  vendor     Vendor           @relation(fields: [vendorId], references: [id])
  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]
  favorites  Favorite[]

  @@index([status, updatedAt(sort: Desc)])
  @@index([categoryId, status])
  @@index([fulfillment, status])
  @@index([vendorId])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  /// Object key in the S3-compatible bucket, e.g. images/<productId>/<uuid>.webp
  key       String
  alt       String  @default("")
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

model ProductVariant {
  id         String  @id @default(uuid())
  productId  String
  sku        String  @unique
  options    Json
  priceToman BigInt?
  inventory  Int?
  position   Int     @default(0)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------------------------
// Administrators (staff). Authentication is implemented by the server itself (scrypt password + TOTP,
// server-side sessions); there is no external identity provider dependency.
// ---------------------------------------------------------------------------------------------

model AdminUser {
  id                String          @id @default(uuid())
  /// Always stored lower-case.
  email             String          @unique
  passwordHash      String
  role              AdminRole
  /// AES-256-GCM encrypted TOTP secret (null = 2FA not enrolled).
  totpSecretEnc     String?
  /// Time step of the last accepted code: a code can never be replayed.
  totpLastStep      Int?
  disabled          Boolean         @default(false)
  failedLogins      Int             @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime        @default(now())
  passwordChangedAt DateTime        @default(now())
  sessions          AdminSession[]
  assignedTickets   SupportTicket[]
  notes             SupportNote[]

  @@map("admin_users")
}

model AdminSession {
  id         String    @id @default(uuid())
  userId     String
  /// SHA-256 of the session token; the token itself is never stored.
  tokenHash  String    @unique
  csrfToken  String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  at         DateTime @default(now())
  actorEmail String
  action     String
  entity     String
  entityId   String
  detail     Json     @default("{}")

  @@index([at(sort: Desc)])
  @@index([entity, entityId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------------------------
// Customers: phone-number accounts, verified by one-time codes sent through a pluggable SMS provider.
// There are no passwords. Personal data is minimal and can be exported and deleted.
// ---------------------------------------------------------------------------------------------

model Customer {
  id                  String         @id @default(uuid())
  /// Canonical Iranian mobile in E.164 (+989XXXXXXXXX). Replaced by "deleted:<id>" when anonymised, which
  /// frees the number for a new registration.
  phone               String         @unique
  firstName           String?
  lastName            String?
  /// Optional contact e-mail. Not verified and never used to sign in.
  email               String?        @unique
  status              CustomerStatus @default(active)
  termsAcceptedAt     DateTime
  termsVersion        String
  marketingOptIn      Boolean        @default(false)
  phoneVerifiedAt     DateTime
  lastLoginAt         DateTime?
  deletionRequestedAt DateTime?
  deletionScheduledAt DateTime?
  anonymizedAt        DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @default(now())

  sessions     CustomerSession[]
  addresses    Address[]
  favorites    Favorite[]
  orders       Order[]
  tickets      SupportTicket[]
  dataRequests CustomerDataRequest[]

  @@index([status, deletionScheduledAt])
  @@map("customers")
}

/// One sign-in challenge. Only a keyed hash of the code is stored.
model CustomerOtp {
  id                String     @id @default(uuid())
  phone             String
  purpose           OtpPurpose @default(sign_in)
  /// HMAC-SHA-256(key derived from the server secret, challenge id + phone + code). Never the code itself.
  codeHash          String
  attempts          Int        @default(0)
  expiresAt         DateTime
  consumedAt        DateTime?
  invalidatedAt     DateTime?
  createdAt         DateTime   @default(now())
  ip                String?
  providerMessageId String?

  @@index([phone, createdAt(sort: Desc)])
  @@index([ip, createdAt])
  @@index([createdAt])
  @@map("customer_otps")
}

model CustomerSession {
  id         String   @id @default(uuid())
  customerId String
  /// SHA-256 of the session token; the token itself is never stored.
  tokenHash  String   @unique
  csrfToken  String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
  @@map("customer_sessions")
}

model Address {
  id             String   @id @default(uuid())
  customerId     String
  label          String?
  recipientName  String
  /// Canonical +989XXXXXXXXX.
  recipientPhone String
  province       String
  city           String
  street         String
  plaque         String?
  unit           String?
  /// Iranian postal code: 10 digits.
  postalCode     String
  notes          String?
  /// At most one default per customer (partial unique index in the constraints migration).
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}

model Favorite {
  customerId String
  productId  String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([customerId, productId])
  @@index([customerId, createdAt(sort: Desc)])
  @@map("favorites")
}

model CustomerDataRequest {
  id          String            @id @default(uuid())
  customerId  String
  type        DataRequestType
  status      DataRequestStatus @default(requested)
  requestedAt DateTime          @default(now())
  completedAt DateTime?
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, type, requestedAt(sort: Desc)])
  @@map("customer_data_requests")
}

// ---------------------------------------------------------------------------------------------
// Orders. Read model for the customer's history: checkout and payments are NOT built yet.
// Order lines snapshot what was bought, so later catalogue edits never change history.
// ---------------------------------------------------------------------------------------------

model Order {
  id           String      @id @default(uuid())
  /// Human-friendly number (shown as e.g. JM-100001).
  number       Int         @unique @default(autoincrement())
  customerId   String
  status       OrderStatus @default(pending)
  /// Sum of the lines, whole Toman (BIGINT).
  totalToman   BigInt
  /// Delivery address and contact as they were at order time. Personal fields are scrubbed on anonymisation.
  shipping     Json
  customerNote String?
  /// Chosen by the browser once per checkout attempt; a retry of the same attempt finds this order instead of creating another.
  requestId    String?
  placedAt     DateTime    @default(now())
  updatedAt    DateTime    @default(now())

  customer      Customer           @relation(fields: [customerId], references: [id])
  items         OrderItem[]
  tickets       SupportTicket[]
  statusHistory OrderStatusEvent[]

  @@unique([customerId, requestId])
  @@index([customerId, placedAt(sort: Desc)])
  @@index([status, placedAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(uuid())
  orderId          String
  productId        String
  vendorId         String
  titleSnapshot    String
  skuSnapshot      String?
  variantSnapshot  Json?
  imageKeySnapshot String?
  unitPriceToman   BigInt
  quantity         Int     @default(1)
  /// Units currently held out of the product's/variant's `inventory` for this line (0 = none: made-to-order lines, orders made
  /// before reservations existed, or already released). Released exactly once when the order is rejected or cancelled.
  reservedQuantity Int     @default(0)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  vendor  Vendor  @relation(fields: [vendorId], references: [id])

  @@index([orderId])
  @@index([vendorId])
  @@map("order_items")
}

/// Every status an order has been in, who changed it and why. Written in the same transaction as the change.
model OrderStatusEvent {
  id         String       @id @default(uuid())
  /// Strictly increasing: the order of events is exact even when two share a timestamp.
  seq        Int          @default(autoincrement())
  orderId    String
  /// null for the first event (the order being placed).
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorType  OrderActor
  /// The staff member's e-mail for staff actions; never a customer's phone number.
  actorLabel String?
  /// Written by staff when rejecting/cancelling and shown to the customer; scrubbed when the customer is anonymised.
  reason     String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

// ---------------------------------------------------------------------------------------------
// Customer support
// ---------------------------------------------------------------------------------------------

model SupportTicket {
  id                    String         @id @default(uuid())
  /// Human-friendly number (shown as e.g. T-1042).
  number                Int            @unique @default(autoincrement())
  customerId            String
  /// Optional; must belong to the same customer (enforced by the service).
  orderId               String?
  subject               String
  category              TicketCategory @default(other)
  status                TicketStatus   @default(open)
  priority              TicketPriority @default(normal)
  assignedToId          String?
  /// Hash of the normalised first message, used to refuse duplicate submissions.
  duplicateKey          String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @default(now())
  lastMessageAt         DateTime       @default(now())
  lastCustomerMessageAt DateTime?
  firstResponseAt       DateTime?
  resolvedAt            DateTime?
  closedAt              DateTime?

  customer   Customer         @relation(fields: [customerId], references: [id])
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedTo AdminUser?       @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   SupportMessage[]
  notes      SupportNote[]

  @@index([status, priority, lastMessageAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([assignedToId, status])
  @@index([customerId, duplicateKey])
  @@map("support_tickets")
}

/// The conversation: what the customer and staff say to each other. Visible to the customer.
model SupportMessage {
  id        String        @id @default(uuid())
  ticketId  String
  author    MessageAuthor
  /// Set for author = customer / staff respectively.
  adminId   String?
  body      String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

/// Internal notes live in their own table on purpose: customer-facing queries never join it,
/// so a bug cannot accidentally expose a note.
model SupportNote {
  id        String        @id @default(uuid())
  ticketId  String
  adminId   String
  body      String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  admin     AdminUser     @relation(fields: [adminId], references: [id])

  @@index([ticketId, createdAt])
  @@map("support_notes")
}

model FaqCategory {
  id       String    @id @default(uuid())
  slug     String    @unique
  title    String
  position Int       @default(0)
  items    FaqItem[]

  @@map("faq_categories")
}

model FaqItem {
  id         String      @id @default(uuid())
  categoryId String
  slug       String      @unique
  question   String
  /// Plain text (line breaks allowed). Rendered as text by clients, never as HTML.
  answer     String
  position   Int         @default(0)
  published  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now())
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, position])
  @@map("faq_items")
}

// ---------------------------------------------------------------------------------------------
// Technical maintenance
// ---------------------------------------------------------------------------------------------

model Incident {
  id         String           @id @default(uuid())
  number     Int              @unique @default(autoincrement())
  title      String
  severity   IncidentSeverity
  status     IncidentStatus   @default(investigating)
  source     IncidentSource   @default(manual)
  summary    String           @default("")
  startedAt  DateTime
  resolvedAt DateTime?
  createdBy  String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @default(now())
  updates    IncidentUpdate[]

  @@index([status, startedAt(sort: Desc)])
  @@map("incidents")
}

model IncidentUpdate {
  id         String          @id @default(uuid())
  incidentId String
  at         DateTime        @default(now())
  author     String
  /// Status after this update, when it changed the status.
  status     IncidentStatus?
  message    String
  incident   Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, at])
  @@map("incident_updates")
}

/// A backup that was taken, and whether a restore from it was ever tested. A backup only counts as
/// "operational" after a successful restore test (see src/domain/maintenance/backup.ts).
model BackupRecord {
  id               String     @id @default(uuid())
  kind             BackupKind
  takenAt          DateTime
  sizeBytes        BigInt
  /// Descriptive location (path or object key); never credentials.
  location         String
  sha256           String?
  encrypted        Boolean    @default(false)
  recordedBy       String
  restoreTestedAt  DateTime?
  restoreTestOk    Boolean?
  restoreTestNotes String?
  createdAt        DateTime   @default(now())

  @@index([kind, takenAt(sort: Desc)])
  @@map("backup_records")
}

/// Aggregated error reports, de-duplicated by fingerprint.
model ErrorReport {
  id          String   @id @default(uuid())
  fingerprint String   @unique
  /// server | storefront | admin
  source      String
  environment String
  release     String?
  name        String
  message     String
  stack       String?
  url         String?
  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  resolved    Boolean  @default(false)

  @@index([lastSeenAt(sort: Desc)])
  @@index([resolved, lastSeenAt(sort: Desc)])
  @@map("error_reports")
}

/// Audit trail for operational actions: deployments, migrations, backups, restores, key rotation,
/// security checks, account recoveries. Separate from the catalogue audit log.
model MaintenanceLog {
  id      String   @id @default(uuid())
  at      DateTime @default(now())
  actor   String
  action  String
  target  String?
  /// success | failure
  outcome String
  detail  Json     @default("{}")

  @@index([at(sort: Desc)])
  @@index([action, at(sort: Desc)])
  @@map("maintenance_log")
}
