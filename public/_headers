# Cloudflare Pages response headers (static demo)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Hashed build assets (JS, CSS, fonts) never change
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Which commit is live (written by the deploy workflow; public and harmless). Never cached, so the post-deploy check sees the truth.
/build-info.json
  Cache-Control: no-store

# Design-review prototypes (not the storefront): never indexed, even if a crawler finds them.
/design-preview/*
  X-Robots-Tag: noindex, nofollow
