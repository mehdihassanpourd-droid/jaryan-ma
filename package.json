{
  "name": "jaryan-ma",
  "version": "0.1.0",
  "private": true,
  "description": "فروشگاه اینترنتی گالری هنر دست‌ساز جریان ما",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run db:validate",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "prebuild": "npm run db:generate",
    "pretypecheck": "npm run db:generate",
    "pretest": "npm run db:generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "api:dev": "tsx server/main.ts",
    "api:build": "esbuild server/main.ts server/cli/admin.ts server/cli/ops.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outbase=server --outdir=dist/server --out-extension:.js=.mjs --log-level=warning",
    "api:start": "node dist/server/main.mjs",
    "admin": "tsx server/cli/admin.ts",
    "admin:prod": "node dist/server/cli/admin.mjs",
    "ops": "tsx server/cli/ops.ts",
    "ops:prod": "node dist/server/cli/ops.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@fontsource-variable/vazirmatn": "^5.2.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-socket": "^0.2.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
