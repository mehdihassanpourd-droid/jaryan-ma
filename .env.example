# Copy to .env for local development. Never commit real values.
# Public site URL (used for metadata only).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Admin API (server/). Nothing below is needed for the static storefront. ----
# Development needs none of these: `npm run api:dev` uses an embedded PostgreSQL and local disk.
# Production values live in a protected env file on the server (docs/admin/SELF-HOSTING.md).

# PostgreSQL connection string (placeholder credentials only). Also read by `prisma migrate deploy`.
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jaryan?schema=public"

# S3-compatible storage (MinIO or any S3 API provider)
# STORAGE_DRIVER="s3"
# S3_ENDPOINT="https://s3.example.com"
# S3_BUCKET="jaryan-media"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# PUBLIC_MEDIA_URL="https://media.example.com"

# 32 random bytes, base64: openssl rand -base64 32 (encrypts TOTP seeds at rest)
# APP_ENCRYPTION_KEY="..."
# ADMIN_ORIGINS="https://admin.example.com"
