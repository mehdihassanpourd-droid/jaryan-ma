# Copy to .env for local development. Never commit real values.
# Public site URL (used for metadata only).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Admin API (server/). Nothing below is needed for the static storefront. ----
# Development needs none of these: `npm run api:dev` uses an embedded PostgreSQL and local disk.
# Production values live in a protected env file on the server (docs/admin/SELF-HOSTING.md).

# PostgreSQL connection string (placeholder credentials only). Also read by `prisma migrate deploy`.
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jaryan?schema=public"

# S3-compatible storage (MinIO or any S3 API provider)
# STORAGE_DRIVER="s3"
# S3_ENDPOINT="https://s3.example.com"
# S3_BUCKET="jaryan-media"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# PUBLIC_MEDIA_URL="https://media.example.com"

# 32 random bytes, base64: openssl rand -base64 32 (encrypts TOTP seeds at rest)
# APP_ENCRYPTION_KEY="..."
# ADMIN_ORIGINS="https://admin.example.com"
# Admin PWA: built by `npm run admin:build`, served by this server at /admin/ (docs/admin/ADMIN-APP.md)
# ADMIN_UI_DIR="dist/admin"
# ADMIN_UI_ENABLED="true"
# Development ONLY (refused in production): create the first administrator in the browser (password + mandatory TOTP).
# FIRST_RUN_SETUP="true"
# Development ONLY (refused in production): accept an https Origin equal to the request host when it ends with this suffix.
# ADMIN_ORIGIN_HOST_SUFFIXES=".app.github.dev"
# Development ONLY (refused in production): GitHub Codespaces rewrites Origin/Host to http://localhost:<port>; accept exactly that (own port, Host must agree, foreign Referer vetoes).
# ADMIN_ACCEPT_REWRITTEN_ORIGIN="true"

# ---- Customer accounts, SMS and support (all optional; off by default in production) ----
# CUSTOMER_ACCOUNTS_ENABLED="false"
# Storefront origin(s) allowed to call the customer API (explicit https origins, no wildcards)
# CUSTOMER_ORIGINS="https://shop.example.com"
# disabled (default in production) | console (development only: prints codes to the log) | http
# SMS_PROVIDER="disabled"
# SMS_HTTP_URL="https://sms-gateway.example.com/send"
# SMS_HTTP_AUTH_HEADER="Bearer REPLACE_ME"
# SMS_HTTP_BODY_TEMPLATE='{"receiver":"{{to}}","message":"{{text}}"}'
# Hard ceiling of verification codes per 24 h for the whole site (cost protection)
# SMS_DAILY_LIMIT="300"

# ---- Maintenance: backups and restore tests (used by `npm run ops`) ----
# BACKUP_DIR="/var/backups/jaryan"
# 32 random bytes, base64 (store it OUTSIDE the server too): openssl rand -base64 32
# BACKUP_ENCRYPTION_KEY="..."
# BACKUP_KEEP_DAYS="30"
# Connection with CREATEDB on a SCRATCH PostgreSQL server, used only by `ops restore-test`
# RESTORE_TEST_ADMIN_URL="postgresql://USER:PASSWORD@scratch-host:5432/postgres"
# RELEASE="2026-03-01"

# ---- SEO (build time; see docs/seo/SEO.md). All optional; the default is closed to search engines. ----
# Public origin used for canonical URLs, the sitemap and structured data (no path, no trailing slash)
# NEXT_PUBLIC_SITE_URL="https://shop.example.com"
# LIVE catalogue (public value, https): base URL under which catalog/ and images/ are served. With it the storefront shows the real
# published products, read in the visitor's browser, so publishing needs no redeploy. Unset = labelled sample content.
# NEXT_PUBLIC_CATALOG_URL="https://media.example.com"
# ORDER SYSTEM (public value, https): base URL of the customer API (sign-in with an SMS code, cart checkout, order history). Needs the backend
# deployed with CUSTOMER_ACCOUNTS_ENABLED=true, CUSTOMER_ORIGINS=<this site> and a real SMS gateway. Unset = the checkout is a labelled DEMO
# that places no order and offers an Instagram message instead.
# NEXT_PUBLIC_ORDER_API_URL="https://api.example.ir"
# Public base URL of the bucket holding the published catalogue snapshot (real products); unset = sample content only
# CATALOG_SNAPSHOT_URL="https://media.example.com"
# CATALOG_SNAPSHOT_DIR="/path/to/snapshot"
# "true" = the site is launched: robots.txt allows crawling, real pages are indexable. Anything else keeps it closed.
# SEO_ALLOW_INDEXING="false"
