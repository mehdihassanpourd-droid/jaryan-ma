# /etc/jaryan-ma/ops.env  (mode 0640, owner root, group jaryan). NEVER commit a real copy.
# The same variables the API server uses (see .env.example) plus the backup settings.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/jaryan
BACKUP_DIR=/var/backups/jaryan
# 32 random bytes, base64. Keep a copy OUTSIDE the server: without it every backup is unreadable.
BACKUP_ENCRYPTION_KEY=
BACKUP_KEEP_DAYS=30
BACKUP_MAX_AGE_HOURS=36
